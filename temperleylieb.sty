% Options
% ---------------------------------------------------------------------------
\keys_define:nn { temperleylieb }
  {
    orientation .choice: ,
    orientation / horizontal .code:n =
      \bool_set_false:N \l__tldiag_vertical_bool ,
    orientation / vertical .code:n =
      \bool_set_true:N \l__tldiag_vertical_bool ,
    horizontal .meta:n = { orientation = horizontal } ,
    horizontal .value_forbidden:n = true ,
    vertical .meta:n = { orientation = vertical } ,
    vertical .value_forbidden:n = true ,
    reverse .bool_set:N = \l__tldiag_reverse_bool ,
    reverse .default:n = true ,

    mode .choice: ,
    mode / compose .code:n = \bool_set_false:N \l__tldiag_separate_bool ,
    mode / separate .code:n = \bool_set_true:N \l__tldiag_separate_bool ,
    compose .meta:n = { mode = compose } ,
    compose .value_forbidden:n = true ,
    separate .meta:n = { mode = separate } ,
    separate .value_forbidden:n = true ,
    reduce .bool_set:N = \l__tldiag_reduce_bool ,
    reduce .default:n = true ,

    strand~sep .fp_set:N = \l__tldiag_S_fp ,
    length .fp_set:N = \l__tldiag_L_fp ,
    gap .fp_set:N = \l__tldiag_gap_fp ,
    separator .tl_set:N = \l__tldiag_separator_tl ,
    names .bool_set:N = \l__tldiag_names_bool ,
    names .default:n = true ,
    labels .bool_set:N = \l__tldiag_labels_bool ,
    labels .default:n = true ,
    boundaries .bool_set:N = \l__tldiag_boundaries_bool ,
    boundaries .default:n = true ,
    coefficient .bool_set:N = \l__tldiag_coefficient_bool ,
    coefficient .default:n = true ,
    loop~value .tl_set:N = \l__tldiag_loop_tl ,

    box .choice: ,
    box / frame .code:n = \tl_set:Nn \l__tldiag_box_tl { tl~box~frame } ,
    box / fill  .code:n = \tl_set:Nn \l__tldiag_box_tl { tl~box~fill } ,
    box / none  .code:n = \tl_set:Nn \l__tldiag_box_tl { tl~box~none } ,

    scale .code:n =
      {
        \fp_set:Nn \l__tldiag_scale_fp {#1}
