\RequirePackage{tikz}
\ProvidesExplPackage{temperleylieb}{2026/10/21}{1.0}
  {Temperley--Lieb algebra diagrams}

% ---------------------------------------------------------------------------
% Variants and messages
% ---------------------------------------------------------------------------
\cs_generate_variant:Nn \prop_put:Nnn { Nee , Nen }
\cs_generate_variant:Nn \clist_put_right:Nn { Ne }
\regex_const:Nn \c__tldiag_int_regex { \A \s* [0-9]+ \s* \Z }
\cs_generate_variant:Nn \prop_get:NnN { Ne }
\prg_generate_conditional_variant:Nnn \prop_get:NnN { Ne } { T , F , TF }
\prg_generate_conditional_variant:Nnn \prop_if_in:Nn { Ne } { T , F , TF }

\msg_new:nnn { temperleylieb } { bad-n }
  { The~number~of~strands~must~be~a~positive~integer~(got~`#1'). }
\msg_new:nnn { temperleylieb } { bad-index }
  {
    Generator~e_{#1}~does~not~exist~in~TL_{#2}.~
    Valid~indices~are~0~(the~identity)~to~#3.
  }
\msg_new:nnn { temperleylieb } { not-an-index }
  { `#1'~is~not~a~valid~generator~index~(expected~a~non-negative~integer). }
\msg_new:nnn { temperleylieb } { expect-underscore }
  { Expected~`_'~after~`e',~but~found~`#1'. }
\msg_new:nnn { temperleylieb } { unexpected }
  {
    Unexpected~`#1'~in~a~Temperley--Lieb~word.~
    Write~words~like~`e_1~e_3~e_2',~use~`1'~or~`e_0'~for~the~identity~
    and~`|'~to~separate~factors.
  }
\msg_new:nnn { temperleylieb } { incomplete }
  { Incomplete~generator~at~the~end~of~a~Temperley--Lieb~word. }
\msg_new:nnn { temperleylieb } { standalone-formula }
  {
    A~diagram~is~used~in~a~formula~that~the~`standalone'~class~does~not~
    turn~into~a~page:~with~its~`tikz'~option~only~TikZ~pictures,~
    \iow_char:N\\[...\iow_char:N\\]~and~\iow_char:N\\(...\iow_char:N\\)~
    become~(cropped)~pages.~Write~the~formula~with~
    \iow_char:N\\[...\iow_char:N\\]~or~\iow_char:N\\(...\iow_char:N\\),~
    or~use~\iow_char:N\\documentclass[varwidth]{standalone}~instead.
  }

